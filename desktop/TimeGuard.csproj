<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>TimeGuard</AssemblyName>
    <RootNamespace>TimeGuard</RootNamespace>
    <Product>息刻</Product>
    <AssemblyTitle>息刻 桌面计时挂件</AssemblyTitle>
    <Version>2.0.3</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 程序图标：由 scripts/make_icon.py 按托盘图标的画法生成，托盘/窗口/快捷方式共用这一份 -->
    <ApplicationIcon>Assets\TimeGuard.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFAC010/WFO0003：DPI 感知由 WPF + app.manifest 负责，WinForms 仅用于托盘图标 -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\App.xaml" />
    <!-- 同一个 .ico 也嵌进程序集：运行时托盘图标直接从它读，和 exe 图标保证一致 -->
    <Resource Include="Assets\TimeGuard.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\NOTICE" Link="NOTICE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\licenses\*" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
