<Window x:Class="TimeGuard.RingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TimeGuard"
        Icon="/Assets/TimeGuard.ico"
        Title="息刻 · 闹钟"
        Width="{x:Static local:RingWindow.CardWidth}"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        PreviewKeyDown="Win_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.80" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.64" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 闹钟响的时候必须一眼看见、一伸手能点到，所以：
         · 整个卡片用暖色调（跟平时冷灰的挂件区分开，余光扫到就知道是叫醒）
         · 弹窗居中、置顶、出现在任务栏
         · 回车 = 知道了，Esc = 稍后提醒（两个键都能收掉，不让人找按钮） -->
    <Border CornerRadius="16" Background="#F21C1A18" BorderBrush="#66FFB174" BorderThickness="2"
            Padding="24,20,24,20" MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <StackPanel>

            <TextBlock x:Name="TxtWho" Text="起床时间到" FontSize="22" FontWeight="Bold"
                       Foreground="#FFFFB174" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" />

            <TextBlock x:Name="TxtTime" Text="06:30" FontFamily="Segoe UI" FontSize="44" FontWeight="Bold"
                       Foreground="#F7FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />

            <TextBlock x:Name="TxtNote" FontSize="12" Foreground="#B3FFFFFF"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,6,0,0" />

            <!-- 连锁闹钟的"还剩几个"：让用户知道这一串还没完，别以为按掉就没事了 -->
            <Border x:Name="BoxChain" CornerRadius="9" Background="#33FFB174" Padding="12,9,12,9"
                    Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="TxtChain" FontSize="12.5" Foreground="#FFFFD9B3"
                           TextWrapping="Wrap" TextAlignment="Center" LineHeight="19" />
            </Border>

            <TextBlock x:Name="TxtAutoStop" FontSize="11.5" Foreground="#8CFFFFFF"
                       HorizontalAlignment="Center" Margin="0,12,0,0" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnSnooze" Grid.Column="0" Style="{StaticResource Btn}"
                        Background="#26FFFFFF" Click="BtnSnooze_Click" />

                <Button Grid.Column="2" Style="{StaticResource Btn}"
                        Background="#4D5DCAA5" Content="知道了" Click="BtnDismiss_Click" />
            </Grid>

            <TextBlock FontSize="11" Foreground="#66FFFFFF" HorizontalAlignment="Center"
                       Margin="0,12,0,0" Text="回车 = 知道了　Esc = 稍后提醒" />
        </StackPanel>
    </Border>
</Window>
