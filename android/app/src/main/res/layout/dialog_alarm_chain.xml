<?xml version="1.0" encoding="utf-8"?>
<!--
  「起床闹钟（连锁）」对话框。
  一次填三项就能生成一整串：起始时间 + 间隔 + 次数。
  也可以不填这里、回主界面的列表里一个个手动加（用户明确要求两条路都留）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="6dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <Button
        android:id="@+id/btnChainStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="26sp"
        tools:text="06:30" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alarm_label_interval"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatEditText
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
            android:id="@+id/etChainInterval"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="3"
            android:textSize="15sp"
            tools:text="5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/label_minutes_unit"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:text="@string/alarm_label_count"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatEditText
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
            android:id="@+id/etChainCount"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="2"
            android:textSize="15sp"
            tools:text="3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/unit_times"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvChainPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="将生成 06:30 / 06:35 / 06:40 三个闹钟" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/swChainWeekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/alarm_weekdays_only"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/alarm_chain_note"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
</LinearLayout>
