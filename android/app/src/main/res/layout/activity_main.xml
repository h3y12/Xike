<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/card_bg"
        app:title="@string/app_name"
        app:titleTextColor="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ============ 当前状态 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_preview"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPreviewScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="62dp"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="40sp"
                        tools:text="100" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPreviewStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            tools:text="快去睡吧。" />

                        <TextView
                            android:id="@+id/tvPreviewDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            tools:text="20:30 出现 → 23:30 开始扣分" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnToggleOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_start_overlay" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 手动倒计时（与健康分无关，独立一块） ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_countdown"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCdPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="130dp"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="30sp"
                        tools:text="00:14:59" />

                    <TextView
                        android:id="@+id/tvCdStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="到 23:45 结束" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatEditText
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:id="@+id/etCdInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_cd_input"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCdStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_cd_start" />

                    <Button
                        android:id="@+id/btnCdToggle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/btn_cd_pause" />

                    <Button
                        android:id="@+id/btnCdReset"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/btn_cd_reset" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_cd_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 闹钟 ============
             与桌面版一致：每个闹钟一个方块、只显示时间和开关，
             生效用主色字、不生效用浅灰字，按时间排（以凌晨四点为界）。
             半小时内会有闹钟响时，OverlayService 会把它写进通知栏。 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_alarm"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAlarmHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/alarm_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <LinearLayout android:id="@+id/alarmRingControls" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
                    <Button android:id="@+id/btnAlarmDismiss" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/btn_alarm_dismiss" />
                    <Button android:id="@+id/btnAlarmSnooze" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/btn_alarm_snooze" />
                </LinearLayout>

                <!-- 闹钟方块列表：由代码按时间顺序填 -->
                <LinearLayout
                    android:id="@+id/llAlarmList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvAlarmEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/alarm_empty"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAlarmAdd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_alarm_add" />

                    <Button
                        android:id="@+id/btnAlarmChain"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/btn_alarm_chain" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_alarm_ring_seconds"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatEditText
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                        android:id="@+id/etAlarmRingSeconds"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textSize="15sp"
                        tools:text="30" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/unit_seconds"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAlarmVibrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_alarm_vibrate"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/label_alarm_note"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                <Button android:id="@+id/btnBackgroundHelp" style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/btn_background_help" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 权限 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/permissionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_permission"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPermOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="未授权（悬浮窗无法显示）" />

                <Button
                    android:id="@+id/btnGrantOverlay"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_grant_overlay" />

                <TextView
                    android:id="@+id/tvPermNotification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="未授权（前台服务通知会被隐藏）" />

                <Button
                    android:id="@+id/btnGrantNotification"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_grant_notification" />
                <TextView android:id="@+id/tvPermAlarm" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/perm_alarm_missing"
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
                <Button android:id="@+id/btnGrantAlarm" style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/btn_grant_alarm" />
                <TextView android:id="@+id/tvPermFullscreen" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/perm_fullscreen_missing"
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
                <Button android:id="@+id/btnGrantFullscreen" style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/btn_grant_fullscreen" />
                <TextView android:id="@+id/tvPermBattery" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/perm_battery_missing"
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
                <Button android:id="@+id/btnGrantBattery" style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/btn_grant_battery" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 时段 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_schedule"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_show_at"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnShowAt"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="88dp"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="16sp"
                        tools:text="20:30" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_deduct_at"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnDeductAt"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="88dp"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="16sp"
                        tools:text="23:30" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_hide_at"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnHideAt"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="88dp"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="16sp"
                        tools:text="06:30" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRulesPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="20:30 出现 100 分 → 23:30 起每 3 分钟扣 1 分 → 06:30 隐藏" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 扣分速率 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_rate"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_per_minutes"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatEditText
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                        android:id="@+id/etMinutes"
                        android:layout_width="58dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textSize="15sp"
                        tools:text="3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/label_minutes_unit"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_deduct"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatEditText
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                        android:id="@+id/etPoints"
                        android:layout_width="58dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textSize="15sp"
                        tools:text="1" />

                    <TextView
                        android:id="@+id/tvPointsUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/label_points_unit"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 状态文案 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_text"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_status_before"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:id="@+id/etStatusBefore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textSize="14sp"
                    tools:text="夜深了，注意休息~" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_status_high"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:id="@+id/etStatusHigh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textSize="14sp"
                    tools:text="快去睡吧。" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_status_mid"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:id="@+id/etStatusMid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textSize="14sp"
                    tools:text="头发要紧，睡觉！" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_status_low"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:id="@+id/etStatusLow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textSize="14sp"
                    tools:text="不睡等死吧你！！！" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 外观与交互 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_look"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_opacity"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/sbOpacity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:min="20" />

                    <TextView
                        android:id="@+id/tvOpacityValue"
                        android:layout_width="46dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="88%" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swThrough"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_through"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_through_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swShowScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_show_score"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swShowCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_show_countdown"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swNotifyToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_notify_toggle"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_notify_toggle_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="版本 1.2.11（14）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:text="@string/app_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
</LinearLayout>
